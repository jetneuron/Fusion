{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicegram-desktop-app/main/src-tauri/tauri.conf.json",
  "productName": "Fusion",
  "version": "0.1.0",
  "identifier": "com.jetneuron.fusion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build"
  },
  "app": {
    "windows": [
      {
        "title": "Fusion",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "../assets/libs": "assets/libs"
    }
  }
}
